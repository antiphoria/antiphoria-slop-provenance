# Antiphoria Slop Provenance environment template.
# Copy to .env and fill in values. Never commit .env.
#
# First-time setup: docs/QUICKSTART.md (Track A = dummy mode + local keys + pytest).

# --- Required for generation (unless dummy mode) ---
GOOGLE_API_KEY=replace-with-your-google-api-key
GENERATOR_MODEL_ID=gemini-2.5-flash

# --- Optional: dummy mode (no Google API, quota-free) ---
GENERATOR_DUMMY_MODE=false
GENERATOR_DUMMY_DELAY_SEC=1.0

# --- Private key paths (injected by run-secure launcher) ---
# Do NOT add PQC_PRIVATE_KEY_PATH or C2PA_PRIVATE_KEY_PATH here when using
# scripts/run-secure.ps1 / scripts/run-secure.sh. For dev with keys on disk, set manually.
# Split vault: private keys on encrypted drive (e.g. K:\), public keys in repo.

# --- Required for ML-DSA signing (use PQC_* or OQS_* variants) ---
# PQC_PRIVATE_KEY_PATH=K:\private.key
OQS_PUBLIC_KEY_PATH=./keys/public.key

# --- Ed25519 (required: classical hybrid alongside ML-DSA) ---
# Private: copy to vault at K:\ed25519_private.pem (run-secure injects when present)
ED25519_PRIVATE_KEY_PATH=K:\ed25519_private.pem
ED25519_PUBLIC_KEY_PATH=./keys/ed25519_public.pem

# --- Optional: custom liboqs install (e.g. Windows/conda, Homebrew prefix) ---
# Install prefix (must contain lib/liboqs.dylib, lib/liboqs.so, etc.). This value
# is copied into the process environment before liboqs-python loads; set it here
# instead of manually exporting in the shell.
# OQS_INSTALL_PATH=C:/path/to/liboqs

# --- Optional signing identity ---
SIGNER_FINGERPRINT=
SIGNING_KEY_VERSION=v1

# --- Registration ceremony (human-only) ---
# Legacy device fingerprint (SHA-256 of MAC). Default: false. Discouraged when
# using operator pseudonym salt + WebAuthn for privacy-preserving personhood.
# CAPTURE_MACHINE_ID=false
#
# Operator pseudonym continuity (optional, privacy-preserving pen-name salt).
# Generate: python scripts/gen-pseudonym-salt.py --out /path/to/vault/pseudonym.salt
# Publishes operatorPseudonymHash (HMAC-SHA256); salt itself is never embedded.
# Losing the salt breaks continuity; leaking it lets others impersonate the pseudonym.
# Rotating the salt creates a fresh unlinkable identity.
# OPERATOR_PSEUDONYM_SALT_PATH=/Volumes/AntiphoriaVault/pseudonym.salt
# Dev fallback only (prefer SALT_PATH on vault):
# OPERATOR_PSEUDONYM_SALT=

# --- Ledger commit author ---
LEDGER_AUTHOR_NAME=Antiphoria Slop Provenance
LEDGER_AUTHOR_EMAIL=bot@antiphoria.local

# --- Runtime ---
# Orchestrator state dir (cache only; never in Archive). All SQLite DBs live here.
# Local: ./.orchestrator-state. Omit to use ./.orchestrator-state
ORCHESTRATOR_STATE_DIR=./.orchestrator-state
# Envelope YAML wire format for register/seal commits. Default v2 when ceremony metadata
# is present; legacy generate/curate auto-fall back to v1. Set v1 to force legacy renderer.
# ENVELOPE_WIRE_VERSION=v2
# Override specific paths (optional; default derived from ORCHESTRATOR_STATE_DIR)
# ARTIFACT_DB_PATH={ORCHESTRATOR_STATE_DIR}/artifacts.db
LOG_LEVEL=INFO
# Skip first-run research/artistic-use prompt (CI, scripts). Set only after reading
# docs/TERMS_OF_USE.md and docs/DISCLAIMER.md.
# ANTIPHORIA_SLOP_PROVENANCE_RESEARCH_ACK=1
# Route trace granularity: minimal | standard | coarse | fine | trace
# coarse=command+adapter flow; fine=handler+service entry; trace=redacted event payload
# LOG_TRACE_GRANULARITY=standard
# Archive repo path. Used by CLI as default for --repo-path.
LEDGER_REPO_PATH=../antiphoria-archive

# --- OTS queue (in Archive repo) ---
# Branch for .provenance/ots-queue.jsonl. Omit to use refs/heads/main.
# OTS_QUEUE_REF=refs/heads/main
# Branch for .provenance/catalog.jsonl. Omit to use refs/heads/main.
# CATALOG_REF=refs/heads/main

# --- Transparency / remote anchor (advanced) ---
# TRANSPARENCY_LOG_PUBLISH_URL=https://<project>.supabase.co/rest/v1/transparency_log
# SUPABASE_SERVICE_KEY=   (preferred for write; required when publish URL is set)
# SUPABASE_ANON_KEY=      (alternative to service key)
# Merkle anchors: auto-derived from TRANSPARENCY_LOG_PUBLISH_URL (transparency_log -> merkle_anchors)
# or set explicitly: MERKLE_ANCHORS_PUBLISH_URL=https://<project>.supabase.co/rest/v1/merkle_anchors

# --- RFC3161 timestamping ---
RFC3161_TSA_URL=http://timestamp.digicert.com
RFC3161_CA_CERT_PATH=./keys/tsa-ca.pem
RFC3161_TSA_UNTRUSTED_CERT_PATH=./keys/tsa.crt

# --- Optional OpenSSL overrides (e.g. Windows) ---
# OPENSSL_BIN=openssl
# OPENSSL_CONF=C:/path/to/openssl.cnf

# --- OpenTimestamps Bitcoin anchoring (full stack default) ---
ENABLE_OTS_FORGE=true
# The `ots` binary must be discoverable: bundled bin/ots, PATH (e.g. after
# `source .venv/bin/activate`), or an absolute path:
# OTS_BIN=/absolute/path/to/project/.venv/bin/ots
OTS_FURNACE_INTERVAL_SEC=3600

# --- WebAuthn / FIDO2 hardware trust layer (full stack default for register/seal) ---
WEBAUTHN_PROVIDER=platform
WEBAUTHN_RP_ID=localhost
# Production domain example (credentials bound to RP ID):
# WEBAUTHN_RP_ID=antiphoria-archive.com
#
# USB FIDO2 key instead of Touch ID:
# WEBAUTHN_PROVIDER=hid
#
# Local bridge port when WEBAUTHN_PROVIDER=platform. Omit for an ephemeral
# OS-assigned port (recommended). Set only if you need a fixed port.
# WEBAUTHN_BRIDGE_PORT=8745

# --- C2PA dual-write (full stack default) ---
ENABLE_C2PA=true
C2PA_MODE=sdk
# Required when C2PA_MODE=sdk (cert chain in repo; leaf key in vault):
# C2PA_SIGN_CERT_CHAIN_PATH=./keys/c2pa-cert-chain.pem
# C2PA_PRIVATE_KEY_PATH=K:\c2pa-leaf.key.pem
# C2PA_SIGNING_ALG=ES256
# C2PA_TSA_URL=https://...   (optional; use a full URL on its own line)
# Do not put #-comments on the same line as KEY=value (parser treats it as the value).
# C2PA_SDK_ASSET_FORMAT=image/jpeg